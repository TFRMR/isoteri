catatan: Program uji coba lengkap Isoteri v2.1
ingat nama: Teks = "Budi"
ingat nilai: Angka = 80
kalau (nilai >= 75) {
    tampilkan "Selamat " + nama + ", Anda lulus!"
} lainnya {
    tampilkan "Maaf " + nama + ", silakan coba lagi."
}
fungsi tambah(a, b) {
    kembalikan a + b
}
fungsi faktorial(n) {
    kalau (n <= 1) {
        kembalikan 1
    }
    kembalikan n * faktorial(n - 1)
}
ingat hasil = tambah(10, 20)
tampilkan "10 + 20 = " + hasil
tampilkan "5! = " + faktorial(5)
catatan: Uji ulang (loop) dan reassignment
ingat i = 0
ingat total = 0
ulang (i < 5) {
    total = total + i
    i = i + 1
}
tampilkan "Total 0..4 = " + total
catatan: Uji operator logika dan perbandingan
ingat cuaca_cerah = benar
ingat suhu = 30
kalau (cuaca_cerah dan suhu > 25) {
    tampilkan "Cocok untuk panen"
} lainnya {
    tampilkan "Tunggu dulu"
}
catatan: Uji operator matematika dan presedensi
tampilkan "2 + 3 * 4 = " + (2 + 3 * 4)
tampilkan "-5 + 10 = " + (-5 + 10)
