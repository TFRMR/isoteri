catatan: Uji Component System -- Todo List sederhana: state, render, aksi (delegated event),
catatan: form input, dan lifecycle hooks (dipasang/diperbarui/dilepas).

bentuk TodoState { item_daftar, teks_input, jumlah_render }
bentuk Todo { teks, selesai }

fungsi render_todo(props, state) {
    ingat daftar_html = ""
    ingat i = 0
    ulang (i < panjang(state.item_daftar)) {
        ingat t = state.item_daftar[i]
        ingat gaya = "padding:4px 0"
        kalau (t.selesai) { gaya = gaya + ";text-decoration:line-through;color:#999" }
        daftar_html = daftar_html + "<li style='" + gaya + "'>" + t.teks +
            " <button data-aksi='hapus' data-indeks='" + i + "'>x</button>" +
            " <button data-aksi='toggle' data-indeks='" + i + "'>v</button></li>"
        i = i + 1
    }
    kembalikan "<div>" +
        "<input data-aksi='ubah_input' data-peristiwa='input' value='" + state.teks_input + "' placeholder='Tugas baru...'>" +
        "<button data-aksi='tambah'>Tambah</button>" +
        "<ul>" + daftar_html + "</ul>" +
        "<p><small>Dirender ulang " + state.jumlah_render + "x</small></p>" +
        "</div>"
}

fungsi aksi_ubah_input(props, state, e) {
    kembalikan TodoState { item_daftar: state.item_daftar, teks_input: e.nilai, jumlah_render: state.jumlah_render + 1 }
}

fungsi aksi_tambah(props, state, e) {
    kalau (panjang(state.teks_input) == 0) {
        kembalikan state
    }
    ingat baru = gabung(state.item_daftar, [Todo { teks: state.teks_input, selesai: salah }])
    kembalikan TodoState { item_daftar: baru, teks_input: "", jumlah_render: state.jumlah_render + 1 }
}

fungsi aksi_hapus(props, state, e) {
    ingat idx = ke_angka(dom_atribut(e.target, "data-indeks"))
    ingat baru = []
    ingat i = 0
    ulang (i < panjang(state.item_daftar)) {
        kalau (i != idx) { baru = gabung(baru, [state.item_daftar[i]]) }
        i = i + 1
    }
    kembalikan TodoState { item_daftar: baru, teks_input: state.teks_input, jumlah_render: state.jumlah_render + 1 }
}

fungsi aksi_toggle(props, state, e) {
    ingat idx = ke_angka(dom_atribut(e.target, "data-indeks"))
    ingat baru = []
    ingat i = 0
    ulang (i < panjang(state.item_daftar)) {
        kalau (i == idx) {
            ingat lama = state.item_daftar[i]
            baru = gabung(baru, [Todo { teks: lama.teks, selesai: !lama.selesai }])
        } lainnya {
            baru = gabung(baru, [state.item_daftar[i]])
        }
        i = i + 1
    }
    kembalikan TodoState { item_daftar: baru, teks_input: state.teks_input, jumlah_render: state.jumlah_render + 1 }
}

fungsi hook_dipasang(props, state) { tampilkan "Todo dipasang." }
fungsi hook_diperbarui(props, state) { tampilkan "Todo dirender ulang, item: " + panjang(state.item_daftar) }

ingat todo_komponen = komponen_buat({
    "state_awal": TodoState { item_daftar: [], teks_input: "", jumlah_render: 0 },
    "render": "render_todo",
    "aksi": {
        "ubah_input": "aksi_ubah_input",
        "tambah": "aksi_tambah",
        "hapus": "aksi_hapus",
        "toggle": "aksi_toggle"
    },
    "dipasang": "hook_dipasang",
    "diperbarui": "hook_diperbarui"
})

komponen_pasang(todo_komponen, dom_pilih("#app"))
